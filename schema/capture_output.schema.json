{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cozmo.example/schema/capture_output/1.0",
  "title": "Cozmo capture output",
  "description": "One JSON per capture. Every measurement is {value, ci90:[lo,hi]} in metres / square metres.",
  "type": "object",
  "required": ["schema_version", "capture", "rooms", "stitched_plan", "damage", "concealed_damage_flags", "scope", "drift", "calibration"],
  "$defs": {
    "measure": {
      "type": "object", "required": ["value", "ci90"],
      "properties": {"value": {"type": "number"}, "ci90": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}
    },
    "measureOrNull": {"oneOf": [{"$ref": "#/$defs/measure"}, {"type": "null"}]},
    "point2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "capture": {
      "type": "object", "required": ["id", "tier", "input", "timing_s"],
      "properties": {"tier": {"enum": ["photo", "video", "lidar"]}}
    },
    "calibration": {"type": "object", "required": ["source", "coverage"]},
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "polygon", "floor_area_m2", "ceiling_height_m", "walls", "openings", "surfaces"],
        "properties": {
          "kind": {"enum": ["room", "connector"]},
          "polygon": {"type": "array", "items": {"$ref": "#/$defs/point2"}, "minItems": 3},
          "floor_area_m2": {"$ref": "#/$defs/measure"},
          "ceiling_height_m": {"$ref": "#/$defs/measureOrNull"},
          "walls": {"type": "array", "items": {
            "type": "object", "required": ["id", "start", "end", "length_m", "observed_fraction"],
            "properties": {"length_m": {"$ref": "#/$defs/measure"}, "height_m": {"$ref": "#/$defs/measureOrNull"},
                           "start": {"$ref": "#/$defs/point2"}, "end": {"$ref": "#/$defs/point2"}}}},
          "openings": {"type": "array", "items": {
            "type": "object", "required": ["id", "type", "wall_id", "width_m"],
            "properties": {"type": {"enum": ["door", "window", "passage"]}, "width_m": {"$ref": "#/$defs/measure"},
                           "height_m": {"$ref": "#/$defs/measureOrNull"}, "connects_to": {"type": ["string", "null"]}}}},
          "surfaces": {"type": "array", "items": {"type": "object", "required": ["id", "kind"],
            "properties": {"kind": {"enum": ["wall", "floor", "ceiling"]}}}}
        }
      }
    },
    "stitched_plan": {
      "type": "object", "required": ["footprint_m2", "n_rooms", "adjacency", "overlaps", "placement"],
      "properties": {
        "footprint_m2": {"$ref": "#/$defs/measure"},
        "adjacency": {"type": "array", "items": {"type": "object", "required": ["rooms", "via"]}}
      }
    },
    "damage": {"type": "array", "items": {
      "type": "object", "required": ["id", "class", "surface_id", "room_id", "area_m2", "extent_width_m", "extent_height_m", "confidence"],
      "properties": {"class": {"enum": ["water_stain", "crack", "mold", "hole", "peeling_paint"]},
                     "area_m2": {"$ref": "#/$defs/measure"}}}},
    "concealed_damage_flags": {"type": "array", "items": {
      "type": "object", "required": ["id", "rule_id", "rule", "surface_id", "damage_ids"]}},
    "scope": {"type": "array", "items": {
      "type": "object", "required": ["id", "surface_id", "code", "description", "quantity", "unit"],
      "properties": {"quantity": {"$ref": "#/$defs/measure"}}}},
    "drift": {"type": "object", "required": ["enabled"]}
  }
}
